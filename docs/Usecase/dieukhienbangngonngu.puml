
@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "Người dùng" as User
actor "Vi điều khiển" as MCU

rectangle "Điều khiển thiết bị bằng ngôn ngữ tự nhiên" {

    usecase "Tiếp nhận và xử lý\nyêu cầu điều khiển" as UC_Control

    usecase "Trích xuất thẻ, ý định,\nlịch từ câu nói" as UC_Phantich

    usecase "Tìm thiết bị phù hợp\nvới các thẻ " as UC_Find

    usecase "Lập lịch\nđiều khiển" as UC_Scheduled

    usecase "Tạo lệnh điều khiển" as cr

    usecase "Thực hiện lệnh điều khiển" as tt

}

User --> UC_Control

UC_Control ..> UC_Phantich : <<include>>
UC_Control ..> UC_Find : <<include>
UC_Control ..> cr: <<include>>


UC_Scheduled ..> UC_Control : <<extend>>

MCU --> tt


@enduml
