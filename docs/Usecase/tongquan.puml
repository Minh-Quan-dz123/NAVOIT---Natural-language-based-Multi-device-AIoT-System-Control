
@startuml
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle

actor "Người dùng" as User
actor "Quản trị viên" as Admin
actor "Vi điều khiển" as MCU

rectangle "Hệ thống nhà thông minh" {

    usecase "Quản lý vi điều khiển" as UC1
    usecase "Quản lý thiết bị" as UC2
    usecase "Quản lý thẻ\nthiết bị" as UC3
    usecase "Điều khiển thiết bị\nbằng ngôn ngữ tự nhiên" as UC4
    usecase "Điều khiển thiết bị\nqua giao diện" as UC5
    usecase "Quản lý lịch\nđiều khiển" as UC6
    usecase "Quản lý loại\nvi điều khiển\nvà loại thiết bị" as UC7


}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

Admin --> UC7

MCU -- UC4
MCU -- UC5
MCU -- UC6

@enduml
